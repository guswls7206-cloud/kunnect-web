{
  "name": "@kunnect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KUnnect 백엔드 API (Fastify + Zod + Drizzle + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "matching:eval": "tsx src/matching/eval/run.ts",
    "matching:eval:write": "tsx src/matching/eval/run.ts --write",
    "matching:smoke": "tsx src/matching/scripts/smoke.ts",
    "test:coverage": "vitest run --coverage",
    "matching:live": "tsx src/matching/eval/live.ts",
    "matching:replay": "tsx src/matching/eval/live-replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "swagger-ui-dist": "^5.33.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
