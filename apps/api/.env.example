# KUnnect API 환경 변수 전체 목록.
# 사용: cp .env.example .env  (로컬 개발) / 운영은 docker compose 용 .env.prod 에 같은 이름으로 채운다(docs/deploy-backend.md).
# .env 는 절대 커밋하지 않는다(.gitignore). 비밀 값(비밀번호·API 키)은 저장소·로그·이미지에 넣지 않는다.
# 형식: 이름=기본값  — "필수"는 운영에서 반드시 정해야 하는 값, "선택"은 비워 두면 기본값을 쓴다.

# ───────────────── 서버 ─────────────────
# 실행 환경. development | test | production.
#  - production: 세션 쿠키에 Secure 속성이 붙는다 → 반드시 HTTPS 로 접속해야 로그인된다. /docs(Swagger)는 꺼진다.
#  - test: 레이트 리밋·로그인 잠금을 끈다(통합 테스트/부하 테스트 전용. 운영 금지).
NODE_ENV=development

# 서버 포트(컨테이너 내부 포트이기도 하다). 기본 4000.
PORT=4000

# 상태 변경 요청(POST/PATCH/DELETE)을 허용할 브라우저 Origin 목록(쉼표 구분, 필수).
# CORS 는 쓰지 않는다. Next.js rewrites(동일 출처 프록시)는 브라우저의 Origin 을 그대로 전달하므로
# "프런트 주소"를 넣어야 한다. 예) https://kunnect.example.com
ALLOWED_ORIGINS=http://localhost:3000

# 신뢰할 프록시 홉 수(선택, 기본 0). 0 이면 X-Forwarded-For 를 무시한다.
#  - API 앞에 리버스 프록시(Nginx/Caddy/Next rewrites 등)가 "한 단계" 있으면 1.
#  - API 를 인터넷에 직접 노출하면서 1 이상으로 두면 클라이언트가 IP 를 위조해 레이트 리밋·로그인 잠금을 피할 수 있다.
#  - 0 으로 두고 프록시 뒤에서 운영하면 모든 사용자가 같은 IP 로 보여 IP 기준 한도를 서비스 전체가 공유한다.
#  - 값 = API 앞 프록시 "대수"(실측 확인, off-by-one 아님): 0 → 소켓 IP, 1 → X-Forwarded-For 의 마지막 값, 2 → 뒤에서 두 번째.
#    예) 브라우저 → Nginx → Next(rewrites) → API 이면 2. docs/deploy-backend.md 5.3 참조. 값을 바꾼 뒤 로그의 req.ip 로 실제 클라이언트 IP 인지 확인한다.
TRUST_PROXY_HOPS=0

# ───────────────── 데이터베이스 ─────────────────
# PostgreSQL 접속 문자열(필수). 운영에서는 compose 가 db 서비스 주소로 조립한다.
DATABASE_URL=postgres://kunnect:kunnect@localhost:5432/kunnect

# 로컬 개발용 embedded-postgres(pnpm db:dev) 설정(선택). 여러 DB 를 동시에 띄울 때 포트/디렉터리를 바꾼다.
# PGPORT=5432
# PGDATA_DIR=./.pgdata

# ───────────────── 파일 저장 ─────────────────
# 사진 저장 디렉터리(선택, 기본 ./storage). 컨테이너 기본값은 /data/storage 이며 볼륨으로 보존한다.
# 서버 프로세스 사용자가 쓰기 가능해야 한다. 디렉터리가 없으면 정적 서빙 등록이 경고를 낸다.
STORAGE_DIR=./storage

# ───────────────── 매칭 / AI ─────────────────
# Anthropic API 키(선택). 서버 전용 비밀이며 클라이언트·로그·이미지에 노출 금지.
# 없으면 매칭은 로컬 점수(위치·태그)만 사용하고, AUTO(알림 발송)는 되지 않는다.
ANTHROPIC_API_KEY=

# 사진이 한쪽이라도 없는 매칭에서 AUTO(알림)를 허용할지(선택, true|false, 기본 true).
# [사용자 결정] 사진 없는 글에 별도 정책 없음 → 일반 AUTO 규칙(엔진 사진 없음 임계 0.85)을 따른다.
# false 면 해당 매칭을 CANDIDATE 로 낮춰 알림을 보내지 않는다(오탐 완화 스위치).
NOPHOTO_AUTO_NOTIFY=true

# 모델 ID(선택). 기본 claude-haiku-4-5-20251001. [가정/제안 — 예산 결정 #11 전]
# CLAUDE_MODEL_EXTRACT=
# CLAUDE_MODEL_COMPARE=

# 일일 AI 호출 상한(선택, 기본 500, 0 이면 AI 호출 없음). DB 카운터로 재시작 후에도 유지된다.
# AI_DAILY_CALL_LIMIT=500
# AI 호출 타임아웃(ms, 기본 30000) / 응답 최대 토큰(기본 400) / 동시 호출 수(기본 2, 1~16)
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=400
# AI_CONCURRENCY=2
# AI 로 보내는 이미지: 긴 변 최대 px(기본 1024, 256~1568) / 최대 바이트(기본 5242880)
# AI_IMAGE_MAX_SIDE=1024
# AI_IMAGE_MAX_BYTES=5242880

# 매칭 점수 가중치(선택, 0~1). 현재 기본: 사진 0.45 / 위치 0.25 / 태그 0.30 (색상 규칙 도입과 함께 조정, 사용자 승인). 바꾸면 시연 결과가 달라진다.
# MATCH_W_PHOTO=0.45
# MATCH_W_LOCATION=0.25
# MATCH_W_TAG=0.30
# 색상 규칙(기본 켬, 사용자 승인): 두 사진의 주 색상이 많이 다르면 점수를 낮추고(MATCH_COLOR_FLOOR 0.7 등),
# AI 비교 점수가 MATCH_COLOR_AUTO_MIN_AI(기본 0.5) 미만이면 AUTO 로 올리지 않는다. 0 이면 이 AUTO 조건을 끈다.
# MATCH_COLOR_FLOOR=0.7
# MATCH_COLOR_MIN_SIM=0.5
# MATCH_COLOR_MIN_CONF=0.5
# MATCH_COLOR_MISMATCH_FACTOR=1
# MATCH_COLOR_AUTO_MIN_AI=0.5
# 사진 없을 때 가중치(위치 0.5 / 태그 0.5)
# MATCH_W_NOPHOTO_LOCATION=0.5
# MATCH_W_NOPHOTO_TAG=0.5
# 임계값: AUTO(알림) 0.80, 사진 없음 AUTO 0.85, 후보 표시 0.60, 사전 점수 컷 0.45. (0~2 범위, 1 초과면 해당 모드 AUTO 비활성)
# MATCH_AUTO_THRESHOLD=0.8
# MATCH_AUTO_THRESHOLD_NOPHOTO=0.85
# MATCH_CANDIDATE_THRESHOLD=0.6
# MATCH_PRESCORE_MIN=0.45
# 민감 사진(학생증·카드·얼굴 등) AI 전송 정책 [사용자 결정: 기본 SKIP — 민감 글의 사진은 Anthropic 에 보내지 않고 태그·위치로만 매칭]
# AI_SENSITIVE_MODE=SKIP            # SKIP(기본) | BLUR(흐림 사본만 전송) | SEND(그대로 전송, 비권장)
# AI_SENSITIVE_TAGS=student_id,wallet,카드   # 민감 글로 보는 태그(프리셋 슬러그 또는 자유 태그)
# AI_SENSITIVE_KEYWORDS=            # 제목·설명에 포함되면 민감 글로 보는 키워드(비우면 기본 목록)
# AI_SENSITIVE_MIN_CONF=0.5         # AI 가 이 신뢰도 이상으로 민감 정보를 감지하면 민감 사진
# MATCH_SENSITIVE_NEVER_AUTO=false  # [사용자 결정 대기, 기본 끔] true 면 민감 글의 매칭은 AUTO(알림)로 올리지 않고 후보로만 표시
# 후보 상한: AI 비교 대상 상위 N(기본 5, 1~50) / 후보 조회 최대 건수(기본 200) / 시간 여유(시간, 기본 24)
# MATCH_TOP_N=5
# MATCH_MAX_CANDIDATES=200
# MATCH_TIME_MARGIN_HOURS=24

# ───────────────── 보존 / 정리 작업 ─────────────────
# 글 종료 후 보존 일수(기본 90) / 쪽지 대화 종료 후 보존 일수(기본 30). README 확정값. 시연에서 줄일 수 있다.
# 정리 작업은 서버 기동 직후 1회 + 6시간마다 자동 실행된다(별도 cron 불필요).
RETENTION_POST_DAYS=90
RETENTION_DM_DAYS=30

# ───────────────── 시연 데이터 ─────────────────
# pnpm db:seed:demo 가 만드는 시연 계정(demo_a~d)의 비밀번호(선택). 미설정 시 scripts/seed-demo.ts 기본값.
# 운영 DB 에는 시연 시드를 실행하지 않는다.
# DEMO_PASSWORD=

# ───────────────── 컨테이너 전용(Dockerfile / docker-compose.prod.yml) ─────────────────
# 기동 시 마이그레이션/카탈로그 시드 자동 실행 여부(기본 true). API 를 여러 대 띄울 때는 1대만 true 로 두거나
# 배포 파이프라인에서 마이그레이션을 1회 실행하고 모두 false 로 둔다.
# RUN_MIGRATIONS=true
# RUN_SEED=true

# docker-compose.prod.yml 이 읽는 값(필수): DB 비밀번호. 충분히 긴 무작위 값으로 정하고 안전하게 보관한다.
# POSTGRES_PASSWORD=
# 호스트에 공개할 API 포트 바인딩(선택, 기본 127.0.0.1:4000 — 리버스 프록시만 접근).
# API_BIND=127.0.0.1:4000

# ───────────────── 테스트 전용(운영에서 쓰지 않음) ─────────────────
# TEST_DATABASE_URL=   통합 테스트가 외부 DB 를 쓰게 한다(없으면 임시 PostgreSQL 자동 기동)
# TEST_LOG=1           테스트 중 서버 로그 출력
# TEST_LOGIN_LOCK=1    테스트에서도 로그인 잠금 활성화
